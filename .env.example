# Backend API Base URL
# In local development, leave empty to use Vite's dev proxy (server.proxy in vite.config.js)
# In production on Vercel, set this environment variable to your deployed backend URL:
# Example: VITE_API_BASE_URL=https://finora-backend.onrender.com
VITE_API_BASE_URL=

# Backend LLM Provider Configuration (Server-Side Only - Never expose to browser or client bundle)
# Groq API Key (Free high-speed Llama inference from https://console.groq.com)
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
